<!-- 主界面布局：垂直滚动卡片流，适配内屏/外屏两种尺寸 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题：机型 + 用途提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/header"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <!-- ===== 卡片一：实时角度 ===== -->
        <TextView
            android:id="@+id/tv_angle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-thin"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/text"
            android:textSize="96sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/angle_caption"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <!-- 0-180° 角度进度条 -->
        <ProgressBar
            android:id="@+id/pb_angle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="22dp"
            android:max="180"
            android:progress="0"
            android:progressBackgroundTint="@color/track"
            android:progressTint="@color/accent" />

        <!-- 统计行：最小值 / 最大值 / 事件计数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_min"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stat_placeholder"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_max"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/stat_placeholder"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_events"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/stat_placeholder"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===== 卡片二：折叠姿态（FoldingFeature） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_posture_title"
                style="@style/SectionTitle"
                android:text="@string/posture_title" />

            <!-- 当前姿态：完全展开 / 半折叠 / 外屏显示中 -->
            <TextView
                android:id="@+id/tv_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/posture_wait"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <!-- 姿态详情：转轴方向 / 是否分隔 / 是否遮挡 / 物理区域 -->
            <TextView
                android:id="@+id/tv_state_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/posture_wait"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 卡片三：转轴传感器硬件信息 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/sensor_title" />

            <!-- 等宽字体展示：名称/类型/厂商/量程/分辨率/唤醒支持/最小采样间隔 -->
            <TextView
                android:id="@+id/tv_sensor_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===== 卡片四：原始事件流（最近 6 条） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/log_title" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 底部操作提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/hint"
            android:textColor="@color/muted"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
