<resources>
    <!-- 应用主题：无标题栏深色主题，状态栏/导航栏透明以配合沉浸式边衬距 -->
    <style name="Theme.HingeDemo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 深色背景配浅色系统图标 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- 卡片小节标题的统一样式（字距/颜色/字号） -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
